SUPER_PDP_ENV=sandbox

# --- Counterpart company, for reception tests (the `tricatel` helper) ---
SUPER_PDP_TRICATEL_CLIENT_ID=
SUPER_PDP_TRICATEL_CLIENT_SECRET=
